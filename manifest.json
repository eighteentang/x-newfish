{
  "manifest_version": 3,
  "name": "X-Newfish",
  "description": "帮助 X 用户筛选时间线并发现值得关注的内容。",
  "version": "0.1.5",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X-Newfish",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "world": "MAIN",
      "js": ["x-net-hook.js", "account-signals.js", "metrics-core.js", "tweet-metrics.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["config.js", "account-signals.js", "metrics-core.js", "filter-core.js", "account-decorations.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
